{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.gstatic.com https://*.googleapis.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://images.scrydex.com https://images.pokemontcg.io https://assets.tcgdex.net https://tcgplayer-cdn.tcgplayer.com https://static.tcgcollector.com https://firebasestorage.googleapis.com https://storage.googleapis.com https://*.googleusercontent.com; connect-src 'self' https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://*.googleapis.com https://*.firebaseapp.com https://firebasestorage.googleapis.com https://challenges.cloudflare.com; frame-src https://accounts.google.com https://*.firebaseapp.com https://challenges.cloudflare.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'" }
      ]
    },
    {
      "source": "/newsletter/admin",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/newsletter/preview/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/assets/(.*)\\.zip",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/newsletter",
      "destination": "/api/newsletter.js"
    },
    {
      "source": "/api/newsletter/og",
      "destination": "/api/newsletter-og.js"
    },
    {
      "source": "/newsletter/submit",
      "destination": "/newsletter/submit.html"
    },
    {
      "source": "/newsletter/admin",
      "destination": "/newsletter/admin.html"
    },
    {
      "source": "/newsletter/subscribe",
      "destination": "/newsletter/subscribe.html"
    },
    {
      "source": "/newsletter/privacy",
      "destination": "/newsletter/privacy.html"
    },
    {
      "source": "/newsletter/preview/:token",
      "destination": "/newsletter/issue.html?preview=:token"
    },
    {
      "source": "/newsletter/:slug",
      "destination": "/api/newsletter-page.js?slug=:slug"
    },
    {
      "source": "/sitemap-newsletter.xml",
      "destination": "/api/sitemap-newsletter.js"
    },
    {
      "source": "/apple-review/route25-screenshots-iphone.zip",
      "destination": "/assets/Route25-App-Store-Screenshots-iPhone.zip"
    },
    {
      "source": "/api/__proxy/:path*",
      "destination": "/api/backend-proxy.js?path=:path*"
    },
    {
      "source": "/api/cards/og",
      "destination": "/api/cards/og.js"
    },
    {
      "source": "/api/cards/og/",
      "destination": "/api/cards/og.js"
    },
    {
      "source": "/sitemap-cards.xml",
      "destination": "/api/sitemap-cards.js"
    },
    {
      "source": "/sitemap-sets.xml",
      "destination": "/api/sitemap-sets.js"
    },
    {
      "source": "/search",
      "destination": "/api/card-search.js"
    },
    {
      "source": "/search/",
      "destination": "/api/card-search.js"
    },
    {
      "source": "/api/card-search",
      "destination": "/api/card-search-data.js"
    },
    {
      "source": "/sets",
      "destination": "/api/set-directory.js"
    },
    {
      "source": "/sets/",
      "destination": "/api/set-directory.js"
    },
    {
      "source": "/cards/:id",
      "destination": "/api/cards.js?id=:id"
    },
    {
      "source": "/cards/:id/",
      "destination": "/api/cards.js?id=:id"
    },
    {
      "source": "/sets/:id",
      "destination": "/api/sets.js?id=:id"
    },
    {
      "source": "/sets/:id/",
      "destination": "/api/sets.js?id=:id"
    },
    {
      "source": "/card-images/:path*",
      "destination": "https://palettetown-backend.vercel.app/card-images/:path*"
    },
    {
      "source": "/set-logos/:path*",
      "destination": "/api/backend-proxy.js?path=set-logos/:path*"
    },
    {
      "source": "/trainer-avatars/:path*",
      "destination": "https://palettetown-backend.vercel.app/trainer-avatars/:path*"
    },
    {
      "source": "/api/proxy/:path*",
      "destination": "/api/backend-proxy.js?path=api/proxy/:path*"
    },
    {
      "source": "/login",
      "destination": "https://palettetown-backend.vercel.app/login"
    },
    {
      "source": "/login/:path*",
      "destination": "https://palettetown-backend.vercel.app/login/:path*"
    },
    {
      "source": "/web",
      "destination": "https://palettetown-backend.vercel.app/web"
    },
    {
      "source": "/web/:path*",
      "destination": "https://palettetown-backend.vercel.app/web/:path*"
    },
    {
      "source": "/api/web",
      "destination": "https://palettetown-backend.vercel.app/api/web"
    },
    {
      "source": "/api/web/:path*",
      "destination": "https://palettetown-backend.vercel.app/api/web/:path*"
    },
    {
      "source": "/api/trainer",
      "destination": "https://palettetown-backend.vercel.app/api/trainer"
    },
    {
      "source": "/api/trainer/:path*",
      "destination": "https://palettetown-backend.vercel.app/api/trainer/:path*"
    },
    {
      "source": "/trainer/:id",
      "destination": "https://palettetown-backend.vercel.app/trainer/:id"
    },
    {
      "source": "/trainer/:id/",
      "destination": "https://palettetown-backend.vercel.app/trainer/:id/"
    },
    {
      "source": "/post/:id",
      "destination": "/api/backend-proxy.js?path=post/:id"
    },
    {
      "source": "/post/:id/",
      "destination": "/api/backend-proxy.js?path=post/:id/"
    },
    {
      "source": "/post",
      "destination": "/api/backend-proxy.js?path=post"
    },
    {
      "source": "/post/",
      "destination": "/api/backend-proxy.js?path=post/"
    },
    {
      "source": "/trade/:id",
      "destination": "https://palettetown-backend.vercel.app/trade/:id"
    },
    {
      "source": "/trade/:id/",
      "destination": "https://palettetown-backend.vercel.app/trade/:id/"
    },
    {
      "source": "/trade",
      "destination": "https://palettetown-backend.vercel.app/trade"
    },
    {
      "source": "/trade/",
      "destination": "https://palettetown-backend.vercel.app/trade/"
    },
    {
      "source": "/collection/:id",
      "destination": "/api/backend-proxy.js?path=collection/:id"
    },
    {
      "source": "/collection/:id/",
      "destination": "/api/backend-proxy.js?path=collection/:id/"
    },
    {
      "source": "/collection",
      "destination": "/api/backend-proxy.js?path=collection"
    },
    {
      "source": "/collection/",
      "destination": "/api/backend-proxy.js?path=collection/"
    },
    {
      "source": "/folders/:id",
      "destination": "/api/backend-proxy.js?path=folders/:id"
    },
    {
      "source": "/folders/:id/",
      "destination": "/api/backend-proxy.js?path=folders/:id/"
    },
    {
      "source": "/folders",
      "destination": "/api/backend-proxy.js?path=folders"
    },
    {
      "source": "/folders/",
      "destination": "/api/backend-proxy.js?path=folders/"
    }
  ],
  "crons": [
    {
      "path": "/api/newsletter-cron.js",
      "schedule": "0 13,14 * * 6"
    },
    {
      "path": "/api/newsletter-maintenance.js",
      "schedule": "30 9 * * *"
    }
  ],
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "**/*",
      "use": "@vercel/static"
    }
  ]
}
