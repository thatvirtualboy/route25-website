{
  "headers": [
    {
      "source": "/assets/(.*)\\.zip",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/newsletter",
      "destination": "/api/newsletter.js"
    },
    {
      "source": "/newsletter/submit",
      "destination": "/newsletter/submit.html"
    },
    {
      "source": "/newsletter/admin",
      "destination": "/newsletter/admin.html"
    },
    {
      "source": "/newsletter/subscribe",
      "destination": "/newsletter/subscribe.html"
    },
    {
      "source": "/newsletter/:slug",
      "destination": "/newsletter/issue.html?slug=:slug"
    },
    {
      "source": "/apple-review/route25-screenshots-iphone.zip",
      "destination": "/assets/Route25-App-Store-Screenshots-iPhone.zip"
    },
    {
      "source": "/api/__proxy/:path*",
      "destination": "https://palettetown-backend.vercel.app/:path*"
    },
    {
      "source": "/api/cards/og",
      "destination": "/api/cards/og.js"
    },
    {
      "source": "/api/cards/og/",
      "destination": "/api/cards/og.js"
    },
    {
      "source": "/sitemap-cards.xml",
      "destination": "/api/sitemap-cards.js"
    },
    {
      "source": "/sitemap-sets.xml",
      "destination": "/api/sitemap-sets.js"
    },
    {
      "source": "/search",
      "destination": "/api/card-search.js"
    },
    {
      "source": "/search/",
      "destination": "/api/card-search.js"
    },
    {
      "source": "/api/card-search",
      "destination": "/api/card-search-data.js"
    },
    {
      "source": "/cards/:id",
      "destination": "/api/cards.js?id=:id"
    },
    {
      "source": "/cards/:id/",
      "destination": "/api/cards.js?id=:id"
    },
    {
      "source": "/sets/:id",
      "destination": "/api/sets.js?id=:id"
    },
    {
      "source": "/sets/:id/",
      "destination": "/api/sets.js?id=:id"
    },
    {
      "source": "/card-images/:path*",
      "destination": "https://palettetown-backend.vercel.app/card-images/:path*"
    },
    {
      "source": "/api/proxy/:path*",
      "destination": "https://palettetown-backend.vercel.app/api/proxy/:path*"
    },
    {
      "source": "/login",
      "destination": "https://palettetown-backend.vercel.app/login"
    },
    {
      "source": "/login/:path*",
      "destination": "https://palettetown-backend.vercel.app/login/:path*"
    },
    {
      "source": "/web",
      "destination": "https://palettetown-backend.vercel.app/web"
    },
    {
      "source": "/web/:path*",
      "destination": "https://palettetown-backend.vercel.app/web/:path*"
    },
    {
      "source": "/api/web",
      "destination": "https://palettetown-backend.vercel.app/api/web"
    },
    {
      "source": "/api/web/:path*",
      "destination": "https://palettetown-backend.vercel.app/api/web/:path*"
    },
    {
      "source": "/api/trainer",
      "destination": "https://palettetown-backend.vercel.app/api/trainer"
    },
    {
      "source": "/api/trainer/:path*",
      "destination": "https://palettetown-backend.vercel.app/api/trainer/:path*"
    },
    {
      "source": "/trainer/:id",
      "destination": "https://palettetown-backend.vercel.app/trainer/:id"
    },
    {
      "source": "/trainer/:id/",
      "destination": "https://palettetown-backend.vercel.app/trainer/:id/"
    },
    {
      "source": "/post/:id",
      "destination": "https://palettetown-backend.vercel.app/post/:id"
    },
    {
      "source": "/post/:id/",
      "destination": "https://palettetown-backend.vercel.app/post/:id/"
    },
    {
      "source": "/post",
      "destination": "https://palettetown-backend.vercel.app/post"
    },
    {
      "source": "/post/",
      "destination": "https://palettetown-backend.vercel.app/post/"
    },
    {
      "source": "/trade/:id",
      "destination": "https://palettetown-backend.vercel.app/trade/:id"
    },
    {
      "source": "/trade/:id/",
      "destination": "https://palettetown-backend.vercel.app/trade/:id/"
    },
    {
      "source": "/trade",
      "destination": "https://palettetown-backend.vercel.app/trade"
    },
    {
      "source": "/trade/",
      "destination": "https://palettetown-backend.vercel.app/trade/"
    },
    {
      "source": "/collection/:id",
      "destination": "https://palettetown-backend.vercel.app/collection/:id"
    },
    {
      "source": "/collection/:id/",
      "destination": "https://palettetown-backend.vercel.app/collection/:id/"
    },
    {
      "source": "/collection",
      "destination": "https://palettetown-backend.vercel.app/collection"
    },
    {
      "source": "/collection/",
      "destination": "https://palettetown-backend.vercel.app/collection/"
    },
    {
      "source": "/folders/:id",
      "destination": "https://palettetown-backend.vercel.app/folders/:id"
    },
    {
      "source": "/folders/:id/",
      "destination": "https://palettetown-backend.vercel.app/folders/:id/"
    },
    {
      "source": "/folders",
      "destination": "https://palettetown-backend.vercel.app/folders"
    },
    {
      "source": "/folders/",
      "destination": "https://palettetown-backend.vercel.app/folders/"
    }
  ],
  "crons": [
    {
      "path": "/api/newsletter-cron.js",
      "schedule": "0 13,14 * * 6"
    }
  ],
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "**/*",
      "use": "@vercel/static"
    }
  ]
}
